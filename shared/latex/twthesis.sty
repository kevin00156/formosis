% ============================================================
% twthesis.sty — 臺灣學位論文共用版面設定
%
% 各校 profile 共用的部分集中在這裡，修 bug 改一次、所有學校一起受惠。
% 學校之間「有限的枚舉差異」用選項表達；封面、書名頁、前置頁順序等
% 結構性差異不放這裡，留在各 profile 的 skeleton 與 thesisprofile.sty。
%
% 由 profiles/<profile>/thesisprofile.sty 以 \RequirePackage[...]{twthesis} 載入：
%   chapnum     = arabic | zh | zhenum  章號：第1章 / 第一章 / 一、
%   secsep      = . | -                 節以下編號的連接符：1.1 / 1-1
%   eqnum       = section | continuous  公式編號：(1-1) / (1)
%   fignum      = continuous | section | subsection
%                                       圖表編號：圖1 / 圖1-1（分章）/ 圖1-1-1（分章節）
%   caplabelsep = space | period        圖表標題：圖1 標題 / 圖1. 標題
%   lofprefix   = true | false          圖目錄/表目錄條目前補「圖 」「表 」
%   urldate     = true | false          false：參考文獻不印瀏覽日期（visited on）
%
% 浮水印（學校要求學生自行加入時）：在 paper.md YAML 設 watermark: <圖檔>，
% 見下方 \TwthesisWatermark。未設定時不輸出任何東西。
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{twthesis}[2026/09/30 Taiwan thesis common layout]

\RequirePackage{kvoptions}
\RequirePackage{etoolbox}
\SetupKeyvalOptions{family=twthesis,prefix=twthesis@}
\DeclareStringOption[arabic]{chapnum}
\DeclareStringOption[.]{secsep}
\DeclareStringOption[section]{eqnum}
\DeclareStringOption[continuous]{fignum}
\DeclareStringOption[space]{caplabelsep}
\DeclareBoolOption[true]{lofprefix}
\DeclareBoolOption[true]{urldate}
\ProcessKeyvalOptions*

\def\twthesis@check#1#2#3{%
  \def\twthesis@tmp{#2}%
  \@for\twthesis@opt:=#3\do{\ifx\twthesis@opt\twthesis@tmp\let\twthesis@tmp\relax\fi}%
  \ifx\twthesis@tmp\relax\else
    \PackageError{twthesis}{Invalid value `#2' for option #1 (allowed: #3)}{}%
  \fi}
\twthesis@check{chapnum}{\twthesis@chapnum}{arabic,zh,zhenum}
\twthesis@check{secsep}{\twthesis@secsep}{.,-}
\twthesis@check{eqnum}{\twthesis@eqnum}{section,continuous}
\twthesis@check{fignum}{\twthesis@fignum}{continuous,section,subsection}
\twthesis@check{caplabelsep}{\twthesis@caplabelsep}{space,period}

\def\twthesis@arabic{arabic}
\def\twthesis@zhenum{zhenum}
\def\twthesis@section{section}
\def\twthesis@subsection{subsection}

% === 封面字距 ===
% Usage: \Spaced[0.5em]{國立中央大學}
% fontspec 的 LetterSpace 對 xeCJK 的中文字型不可靠；這裡在每個字元/記號之間插固定 kern。
\newcommand{\Spaced}[2][0.5em]{%
  \begingroup
  \def\twthesis@SpacedKern{#1}%
  \expandafter\twthesis@SpacedDo\expanded{#2}\relax
  \endgroup
}
\def\twthesis@SpacedDo#1#2\relax{%
  #1%
  \ifx\relax#2\relax
  \else
    \kern\twthesis@SpacedKern
    \twthesis@SpacedDo#2\relax
  \fi
}

\RequirePackage{titlesec}
\RequirePackage{makecell}
\RequirePackage{indentfirst}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{hyperref}
\RequirePackage{xcolor}
\RequirePackage{float}
\RequirePackage{longtable}
\RequirePackage{colortbl}
\ifx\twthesis@chapnum\twthesis@arabic\else
  \RequirePackage{zhnumber}
\fi

% === 圖表位置:偏好原位,允許少量浮動 ===
\floatplacement{figure}{!htbp}
\floatplacement{table}{!htbp}

% === 公式:靠左 ===
% \mathindent 只有在 documentclass 帶 fleqn 時才存在;未帶 fleqn 的文件
% 直接 \setlength 會碰到未定義長度,導致封面前漏出 "0pt" 且多出一張空白頁。
% 先補定義當安全網(無 fleqn 時公式維持置中,但不會編譯出錯)。
\ifdefined\mathindent\else\newlength{\mathindent}\fi
\setlength{\mathindent}{0pt}
% === 公式編號:節號-公式號 (1-1),或全文連續 (1) ===
\ifx\twthesis@eqnum\twthesis@section
  \numberwithin{equation}{section}
  \renewcommand{\theequation}{\arabic{section}-\arabic{equation}}
\fi

% === 超連結設定 ===
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  citecolor=blue,
  urlcolor=blue
}

% === 首行縮排 2 字元 ===
\setlength{\parindent}{2em}

% === 圖表標題置中,名稱中文化 ===
\captionsetup{justification=centering}
\edef\twthesis@tmp{%
  \noexpand\captionsetup[figure]{name={圖},labelsep=\twthesis@caplabelsep}%
  \noexpand\captionsetup[table]{name={表},labelsep=\twthesis@caplabelsep}}
\twthesis@tmp

% === 目錄/圖目錄/表目錄標題 ===
\renewcommand{\contentsname}{目錄}
\renewcommand{\listfigurename}{圖目錄}
\renewcommand{\listtablename}{表目錄}

% === 圖目錄/表目錄條目:編號前補「圖 」「表 」,與內文標號一致 ===
\iftwthesis@lofprefix
  \renewcommand*\l@figure[2]{%
    \begingroup
    \renewcommand*\numberline[1]{\hb@xt@\@tempdima{圖 ##1\hfil}}%
    \@dottedtocline{1}{0em}{3.5em}{#1}{#2}%
    \endgroup
  }
  \renewcommand*\l@table[2]{%
    \begingroup
    \renewcommand*\numberline[1]{\hb@xt@\@tempdima{表 ##1\hfil}}%
    \@dottedtocline{1}{0em}{3.5em}{#1}{#2}%
    \endgroup
  }
\fi

% === 章節編號 ===
% 章號可用中文數字；節以下一律阿拉伯數字，以 secsep 連接（1.1、1.1.1 或 1-1、1-1-1）。
% \zhnum{section} 是可展開的：寫進 .toc / .aux 時就定值（\zhnumber{\value{section}}
% 會延到排版時才求值，目錄與 \ref 全變成「零」）。
\ifx\twthesis@chapnum\twthesis@arabic
  \renewcommand{\thesection}{\arabic{section}}
\else
  \renewcommand{\thesection}{\zhnum{section}}
\fi
\ifx\twthesis@chapnum\twthesis@zhenum
  \newcommand{\twthesis@chaplabel}{\thesection、}
  \newcommand{\twthesis@chapsep}{0pt}
\else
  \newcommand{\twthesis@chaplabel}{第\thesection 章}
  \newcommand{\twthesis@chapsep}{1em}
\fi
% zhenum:目錄的章條目也要「一、」(\thesection 本身不含「、」,\ref 才能接「第…章」以外的寫法)
\ifx\twthesis@chapnum\twthesis@zhenum
  \let\twthesis@l@section\l@section
  \renewcommand*\l@section[2]{%
    \begingroup
    \let\twthesis@numberline\numberline
    \renewcommand*\numberline[1]{\twthesis@numberline{##1、}}%
    \twthesis@l@section{#1}{#2}%
    \endgroup}
\fi
\renewcommand{\thesubsection}{\arabic{section}\twthesis@secsep\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection\twthesis@secsep\arabic{subsubsection}}
\renewcommand{\theparagraph}{\thesubsubsection\twthesis@secsep\arabic{paragraph}}

% === 圖表編號:全文連續 圖1,分章 圖1-1,或分章節 圖1-1-1 ===
\ifx\twthesis@fignum\twthesis@section
  \counterwithin{figure}{section}
  \counterwithin{table}{section}
  \renewcommand{\thefigure}{\arabic{section}-\arabic{figure}}
  \renewcommand{\thetable}{\arabic{section}-\arabic{table}}
\fi
\ifx\twthesis@fignum\twthesis@subsection
  \counterwithin{figure}{subsection}
  \counterwithin{table}{subsection}
  \renewcommand{\thefigure}{\arabic{section}-\arabic{subsection}-\arabic{figure}}
  \renewcommand{\thetable}{\arabic{section}-\arabic{subsection}-\arabic{table}}
\fi

% === 章標題格式:置中、加粗、加上「第 X 章」前綴 ===
\titleformat{\section}
  {\centering\Large\bfseries}
  {\twthesis@chaplabel}{\twthesis@chapsep}{}
\titlespacing*{\section}{0pt}{0pt}{24pt}

% === 節標題格式 ===
\titleformat{\subsection}
  {\large\bfseries}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{18pt}{6pt}

% === 小節標題格式 ===
\titleformat{\subsubsection}
  {\normalsize\bfseries}
  {\thesubsubsection}{1em}{}
\titlespacing*{\subsubsection}{0pt}{12pt}{6pt}

% === 第四層標題格式 ===
\titleformat{\paragraph}
  {\normalsize\bfseries}
  {\theparagraph}{1em}{}
\titlespacing*{\paragraph}{0pt}{12pt}{6pt}

% === 頁碼樣式 ===
\fancypagestyle{frontmatter}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}
\fancypagestyle{mainmatter}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% === 浮水印(臺大、陽明交大、北科大、中正等要求學生自行加入;系統會加的學校勿用)===
% thesis.latex 在 YAML 有 watermark: <圖檔> 時呼叫 \TwthesisWatermark{<圖檔>}。
% 預設置中、寬為紙寬 1/3;學校規定位置不同時,profile 重新定義 \TwthesisWatermarkPlace。
% 不該有浮水印的頁面(例如審定書)前後用 \WatermarkOff / \WatermarkOn。
\newif\iftwthesis@wm
\newcommand{\twthesis@wmfile}{}
\newcommand{\TwthesisWatermarkPlace}[1]{%
  \put(0.5\paperwidth,0.5\paperheight){\makebox(0,0){\includegraphics[width=0.33\paperwidth]{#1}}}}
\newcommand{\TwthesisWatermark}[1]{%
  \RequirePackage{eso-pic}%
  % Pandoc 會把 YAML 路徑的 _ 跳脫成 \_;還原成字面底線才是真正的檔名
  \begingroup\def\_{\string_}\xdef\twthesis@wmfile{#1}\endgroup
  \IfFileExists{\twthesis@wmfile}{}{%
    \PackageError{twthesis}{找不到浮水印檔 \twthesis@wmfile（YAML watermark: 的路徑相對於 paper.md）}{}}%
  \twthesis@wmtrue
  \AddToShipoutPictureBG{\iftwthesis@wm\TwthesisWatermarkPlace{\twthesis@wmfile}\fi}}
\newcommand{\WatermarkOff}{\twthesis@wmfalse}
\newcommand{\WatermarkOn}{\twthesis@wmtrue}

% === 左右對齊 ===
\RequirePackage{ragged2e}
\justifying
\setlength{\emergencystretch}{3em}

% === 技術識別符允許在底線處換行;math mode 內保留原行為,避免 \mathit{a\_b} 之類爆掉 ===
\let\twthesis@origunderscore\_
\renewcommand{\_}{\ifmmode\twthesis@origunderscore\else\textunderscore\allowbreak\fi}

% === 實驗數據變數套件(在 paper.md 用 \def\xxx{値} + \FPeval 集中管理數字) ===
\RequirePackage{fp}

% === 參考文獻不印瀏覽日期 ===
% biblatex 預設對 @online 等條目的 urldate 會輸出「visited on MM/DD/YYYY」。
% 用 sourcemap 在 biber 資料層 null 掉 urldate；\clearfield{urldate} 清不到拆解後的
% urlyear/urlmonth/urlday 元件（ieee 樣式實測無效）。biblatex 在本套件之後才載入，
% 故延到導言區結尾再宣告。
\iftwthesis@urldate\else
  \AtEndPreamble{\@ifpackageloaded{biblatex}{%
    \DeclareSourcemap{\maps[datatype=bibtex]{\map{\step[fieldset=urldate, null]}}}}{}}
\fi

\endinput
